{
  "public": "out",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "**/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0"
        }
      ]
    },
    {
      "source": "**/*.@(jpg|jpeg|gif|png|webp|avif|geojson|json|txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/data/mountains.json", "destination": "/data/coords/mountains.json" },
    { "source": "/data/rivers.json", "destination": "/data/coords/rivers.json" },
    { "source": "/data/external_borders.json", "destination": "/data/coords/external_borders.json" },
    { "source": "/data/internal_borders.json", "destination": "/data/coords/internal_borders.json" }
  ]
}
