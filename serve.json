{
  "public": "out",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "**/*.@(jpg|jpeg|gif|png|webp|avif|geojson|json|txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/bharatvarsha/__next.bharatvarsha.__PAGE__.txt", "destination": "/bharatvarsha.txt" },
    { "source": "/bharatvarsha/__next.bharatvarsha.txt", "destination": "/bharatvarsha.txt" },
    { "source": "/:page/__next.:page.__PAGE__.txt", "destination": "/:page.txt" },
    { "source": "/:page/__next.:page.txt", "destination": "/:page.txt" },
    { "source": "/bharatvarsha/", "destination": "/bharatvarsha" }
  ]
}
